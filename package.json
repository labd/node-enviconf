{
	"name": "@labdigital/enviconf",
	"version": "1.0.0",
	"license": "MIT",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "A simple library to parse environment variables",
	"engines": {
		"node": ">=22"
	},
	"keywords": [],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"module": "dist/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"src"
	],
	"packageManager": "pnpm@12.12.1",
	"scripts": {
		"build": "tsdown",
		"check": "biome check && tsc",
		"test": "pnpm vitest run",
		"test:ci": "pnpm vitest run --coverage",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"format": "biome format --write",
		"lint": "biome lint",
		"tsc": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"tsdown": "^0.23.1",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-enviconf.git"
	}
}
